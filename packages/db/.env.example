# =============================================================================
# packages/db - Prisma schema and client (@workspace/db)
# =============================================================================
# Usage:
#   cp packages/db/.env.example packages/db/.env
#
# Needed by Prisma CLI commands in this package: generate, db:push, seed.
# apps/svc-api has its own apps/svc-api/.env; keep both DATABASE_URL values
# pointing at the same database.
# =============================================================================

# Postgres/Neon (current team default). Ask a teammate for the shared
# dev-branch credentials, or point this at your own local Postgres instance.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"
# Direct (non-pooled) connection, used by `prisma db push` / migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Fully offline alternative: SQLite, zero external infrastructure. Resolves to
# packages/db/prisma/dev.db. Uncomment and comment out DATABASE_URL above —
# requires schema.prisma (not schema.postgres.prisma).
# DATABASE_URL="file:./dev.db"
