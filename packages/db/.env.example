# =============================================================================
# packages/db - Prisma schema và client (@workspace/db)
# =============================================================================
# Cách dùng:
#   cp packages/db/.env.example packages/db/.env
#
# Cần cho các lệnh Prisma CLI trong package này: generate, db:push, seed.
# apps/svc-api có file apps/svc-api/.env riêng của nó — nhớ giữ giá trị
# DATABASE_URL ở cả 2 nơi trỏ về CÙNG một database, không thì mỗi bên đọc/ghi
# một database khác nhau mà không hề biết.
# =============================================================================

# Postgres/Neon (mặc định hiện tại của team). Xin đồng nghiệp URL nhánh dev
# dùng chung, hoặc trỏ vào Postgres của riêng bạn.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"
# Kết nối trực tiếp (không qua pool), dùng khi chạy `prisma db push` / migrate.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Phương án chạy offline hoàn toàn: SQLite, không cần hạ tầng ngoài. Trỏ vào
# packages/db/prisma/dev.db. Muốn dùng thì bỏ comment dòng dưới và comment
# lại DATABASE_URL ở trên — lưu ý bắt buộc dùng schema.prisma (không phải
# schema.postgres.prisma), vì 2 schema khai báo provider khác nhau.
# DATABASE_URL="file:./dev.db"
