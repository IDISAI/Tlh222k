# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnpm-store/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build
dist

# turbo
.turbo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets stay local; only .env.example templates are committed
.env
.env.*
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# `tsc` must emit to dist/.next, never alongside source. Local accidental
# emits shadow TypeScript imports and make Next/Nest run stale code.
/apps/**/*.js
/apps/**/*.d.ts
/apps/**/*.d.ts.map
/packages/core/src/**/*.js
/packages/core/src/**/*.d.ts
/packages/core/src/**/*.d.ts.map
/packages/ui/src/**/*.js
/packages/ui/src/**/*.d.ts
/packages/ui/src/**/*.d.ts.map
/packages/db/src/**/*.js
/packages/db/src/**/*.d.ts
/packages/db/src/**/*.d.ts.map
/packages/db/prisma/**/*.js
/packages/db/prisma/**/*.d.ts
/packages/db/prisma/**/*.d.ts.map
# Package-root configs emit too, and the src/** rules above never reach them —
# which is how vitest.config.js/.d.ts once got committed.
/packages/*/vitest.config.js
/packages/*/vitest.config.d.ts
/packages/*/vitest.config.d.ts.map
# CocoIndex Code (ccc)
/.cocoindex_code/
.gstack/
.tmp/

# Playwright notion QA (local only)
tools/pw-notion/profile/
tools/pw-notion/state.json
tools/pw-notion/shots/
tools/pw-notion/*.mjs
.env*

# Local dev-runner output and scratch plans, never part of a build.
.zcode/
*.dev.err.log
*.dev.out.log
.*-dev.err.log
.*-dev.out.log

# vercel env sync
scripts/vercel-env/manifest.json
