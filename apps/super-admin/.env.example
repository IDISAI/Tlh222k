# =============================================================================
# apps/super-admin - frontend super-admin và quản lý user (port 3003)
# =============================================================================
# Cách dùng:
#   cp apps/super-admin/.env.example apps/super-admin/.env.local
#
# Ở production app này được Multi-Zone gắn dưới prefix /super-admin. Ở dev
# thì chạy thẳng tại http://localhost:3003, không có prefix.
# =============================================================================

# Đăng nhập Clerk
# Lấy cả 2 key tại: https://dashboard.clerk.com -> app của bạn -> API Keys.
# Dùng chung 1 app Clerk như web, admin và svc-api.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/users

# Bypass đăng nhập chỉ dùng khi dev
# Công tắc chính: đặt "false" để bắt buộc dùng Clerk thật ở local.
NEXT_PUBLIC_ENABLE_DEV_AUTH_BYPASS=true
# Không bắt buộc. Vai trò: user, admin, super-admin. Chỉ có tác dụng khi
# công tắc trên = "true". Bị bỏ qua hoàn toàn ở production.
NEXT_PUBLIC_DEV_AUTH_ROLE=super-admin

# Multi-Zone
# Nút chuyển platform (platform switcher) luôn trỏ link chéo-zone về host web.
NEXT_PUBLIC_HOST_URL=http://localhost:3000

# Backend (quản lý user + roadmap). Để trống → @workspace/core tự rơi về
# mock/localStorage cục bộ, kết quả là danh sách user hiện trống rỗng.
# NEXT_PUBLIC_SVC_ROADMAP_URL là tên cũ, vẫn được hỗ trợ như legacy fallback.
NEXT_PUBLIC_SVC_API_URL=http://localhost:3005

# Sentry (không bắt buộc)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Chỉ dùng lúc build để upload source map lên Sentry. Token cần quyền
# project:releases.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
