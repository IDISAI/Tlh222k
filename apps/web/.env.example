# =============================================================================
# apps/web - frontend công khai và host Multi-Zone (port 3000)
# =============================================================================
# Cách dùng:
#   cp apps/web/.env.example apps/web/.env.local
#
# Điền giá trị thật vào .env.local. .env.local đã bị gitignore, không lo lộ.
# NEXT_PUBLIC_* sẽ bị lộ ra trình duyệt (browser đọc được) — không bao giờ
# nhét secret thật vào biến có tiền tố này.
# =============================================================================

# Đăng nhập Clerk
# Lấy cả 2 key tại: https://dashboard.clerk.com -> app của bạn -> API Keys.
# Dùng chung 1 app Clerk cho web, admin, super-admin và svc-api — vì cả 4
# service phải chia sẻ cùng một session cookie đăng nhập.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Bypass đăng nhập chỉ dùng khi dev
# Công tắc chính: đặt "false" để bắt buộc dùng Clerk thật ở local.
NEXT_PUBLIC_ENABLE_DEV_AUTH_BYPASS=true
# Không bắt buộc. Set user, admin hoặc super-admin để giả lập vai trò mà
# không cần đăng nhập Clerk thật. Chỉ có tác dụng khi công tắc trên = "true".
# Bị bỏ qua hoàn toàn ở production (an toàn, không sợ quên tắt khi deploy).
NEXT_PUBLIC_DEV_AUTH_ROLE=super-admin

# Host Multi-Zone
# URL host khi chạy dev. Để trống ở production trừ khi link chéo giữa các
# zone (web/admin/super-admin) cần override thủ công.
NEXT_PUBLIC_HOST_URL=http://localhost:3000
# Override URL của admin/super-admin — chỉ cần ở production. Ở dev mặc định
# tự trỏ về localhost:3002/3003 nên không cần khai báo 2 dòng dưới.
# ADMIN_URL=https://your-admin.vercel.app
# SUPER_ADMIN_URL=https://your-super-admin.vercel.app

# Backend roadmap
# Trỏ vào đây để dùng backend svc-api thật. Nếu để trống, @workspace/core sẽ
# tự rơi về mock/localStorage cục bộ (không có dữ liệu thật, chỉ demo UI).
# Tính năng Notion (tài liệu) giờ BẮT BUỘC phải có biến này — không còn
# đường lùi gọi Prisma trực tiếp nữa. NEXT_PUBLIC_SVC_ROADMAP_URL vẫn còn
# được hỗ trợ như tên cũ (legacy), phòng khi code đâu đó còn dùng tên đó.
NEXT_PUBLIC_SVC_API_URL=http://localhost:3005

# Sentry (không bắt buộc)
# DSN phía client: Sentry project -> Settings -> Client Keys (DSN). Để trống
# thì Sentry tự tắt (no-op), không ảnh hưởng app.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# DSN phía server có thể dùng chung DSN trên. Để trống sẽ tự rơi về giá trị
# của NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Chỉ dùng lúc build để upload source map lên Sentry. Token cần quyền
# project:releases.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Tính năng Notebook: dùng chung kernel-server (admin ghi, web đọc).
# Để trống → web tự rơi về file .ipynb đã commit sẵn, admin lưu localStorage.
NEXT_PUBLIC_KERNEL_SERVER_URL=http://localhost:3006

# Notion workspace (trang xem /notion/[slug], chỉ đọc)
# Database Prisma dùng chung với packages/db và trình soạn ở admin. Giá trị
# phải khớp DATABASE_URL trong packages/db/.env chính xác từng ký tự (cùng
# schema, cùng provider).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"
