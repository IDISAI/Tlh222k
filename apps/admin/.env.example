# =============================================================================
# apps/admin - frontend admin và roadmap builder (port 3002)
# =============================================================================
# Cách dùng:
#   cp apps/admin/.env.example apps/admin/.env.local
#
# Ở production app này được Multi-Zone gắn dưới prefix /admin. Ở dev thì chạy
# thẳng tại http://localhost:3002, không có prefix /admin — nên các URL dưới
# đây không cần prefix, chỉ prod mới cần (đã lưu trong Vercel).
# =============================================================================

# Đăng nhập Clerk
# Lấy cả 2 key tại: https://dashboard.clerk.com -> app của bạn -> API Keys.
# Dùng chung 1 app Clerk như web, super-admin và svc-api.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/roadmaps

# Bypass đăng nhập chỉ dùng khi dev
# Công tắc chính: đặt "false" để bắt buộc dùng Clerk thật ở local.
NEXT_PUBLIC_ENABLE_DEV_AUTH_BYPASS=true
# Không bắt buộc. Vai trò: user, admin, super-admin. Chỉ có tác dụng khi
# công tắc trên = "true". Bị bỏ qua hoàn toàn ở production.
NEXT_PUBLIC_DEV_AUTH_ROLE=super-admin

# Multi-Zone
# Nút chuyển platform (platform switcher) luôn trỏ link chéo-zone về host web.
NEXT_PUBLIC_HOST_URL=http://localhost:3000
# Origin gốc của web, dùng cho link copy sau khi publish 1 notebook. Bị bỏ
# qua khi editor được mở qua prefix /admin của host web — lúc đó origin
# hiện tại đã CHÍNH LÀ zone web rồi, nhờ vậy preview deploy sẽ tự copy đúng
# link preview của chính nó thay vì link production.
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Backend (roadmap + notion). Notion giờ BẮT BUỘC phải có biến này — không
# còn đường lùi gọi Prisma trực tiếp. NEXT_PUBLIC_SVC_ROADMAP_URL vẫn được
# hỗ trợ như tên cũ (legacy fallback).
NEXT_PUBLIC_SVC_API_URL=http://localhost:3005
# Chỉ cần trên Vercel Preview. NEXT_PUBLIC_SVC_API_URL là 1 giá trị tĩnh dùng
# chung cho MỌI branch (Vercel không có preview env theo từng branch), nên mặc
# định preview build luôn gọi backend production — schema cũ, sai với branch
# đang thêm field mới. Đặt biến này 1 lần (Vercel dashboard, scope Preview) để
# preview tự trỏ đúng svc-api preview deployment của CHÍNH branch đó:
# NEXT_PUBLIC_SVC_API_PREVIEW_URL_TEMPLATE=https://tlh222k-svc-api-git-{branch}-idis.vercel.app
NEXT_PUBLIC_SVC_API_PREVIEW_URL_TEMPLATE=

# Sentry (không bắt buộc)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Tính năng Notebook: dùng chung kernel-server cho trình soạn notebook.
# Để trống → trình soạn ở admin tự lưu localStorage (chỉ máy đó thấy được).
NEXT_PUBLIC_KERNEL_SERVER_URL=http://localhost:3006

# Notion workspace (trình soạn /notion/[slug])
# Database Prisma dùng chung với packages/db và trang xem ở web. Giá trị
# phải khớp DATABASE_URL trong packages/db/.env chính xác từng ký tự (cùng
# schema, cùng provider).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"
# Token Vercel Blob cho upload ảnh bìa / file trong trình soạn Notion.
# Lấy tại: Vercel dashboard -> Storage -> Blob -> store của bạn -> Tokens
# (hoặc chạy `vercel blob store add` rồi `vercel env pull`). Thiếu biến này
# thì chức năng upload sẽ lỗi.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me
