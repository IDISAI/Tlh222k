# kernel-server (Go) — CRUD notebook + auth + CORS. Copy thành .env để chạy dev.

PORT=3006
APP_ENV=development
STORAGE_DIR=./storage/notebooks

# Bypass đăng nhập chỉ dùng khi dev: coi mọi request đang mang vai trò này,
# bỏ qua bước xác thực JWT thật. PHẢI để trống hoặc "false" ở production —
# nếu quên tắt thì bất kỳ ai cũng vào được với quyền super-admin, không xác
# thực gì cả.
# Công tắc chính là ENABLE_DEV_AUTH_BYPASS. Cặp biến này tương ứng với
# NEXT_PUBLIC_ENABLE_DEV_AUTH_BYPASS / NEXT_PUBLIC_DEV_AUTH_ROLE bên các app
# Next.js — cùng 1 cơ chế, chỉ khác không có tiền tố NEXT_PUBLIC_ vì đây là
# server Go, không có khái niệm "lộ ra browser".
ENABLE_DEV_AUTH_BYPASS=true
DEV_AUTH_ROLE=super-admin

# Xác thực thật ở production: verify JWT session của Clerk qua endpoint JWKS
# này (để trống DEV_AUTH_ROLE thì cơ chế này mới bật). Tìm JWKS URL trong
# Clerk dashboard.
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=

# Danh sách origin trình duyệt được phép gọi server này (CORS).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# Bắt buộc phải có — dùng ký vé kết nối browser-to-proxy có hạn 5 phút.
SESSION_TICKET_SECRET=replace-with-a-long-random-production-secret

# Deploy dạng container dùng chung 1 Docker broker nội bộ, chính sách cố
# định. Chỉ để trống cả 2 biến dưới khi chạy dev trực tiếp trên máy host qua
# dev.mjs (không qua container).
JUPYTER_BROKER_URL=
JUPYTER_BROKER_TOKEN=
# Chỉ cần trên Linux: group ID sở hữu /var/run/docker.sock, dùng cho broker
# chạy qua docker compose.
DOCKER_GID=0

# Hạn mức sandbox (mặc định gói miễn phí).
JUPYTER_MAX_SESSIONS=2
JUPYTER_MAX_SESSIONS_PER_OWNER=1
JUPYTER_SESSION_IDLE_SECONDS=900
JUPYTER_SESSION_CPU=1
JUPYTER_SESSION_MEMORY=2g
JUPYTER_SESSION_PIDS=128
JUPYTER_DOCKER_NETWORK=notebook-internal
