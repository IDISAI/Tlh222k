# =============================================================================
# apps/svc-api - backend NestJS: GraphQL + REST + SSE (port 3005)
# =============================================================================
# Cách dùng:
#   cp apps/svc-api/.env.example apps/svc-api/.env
#
# Đây là env chỉ dùng phía server thôi. Không dùng tiền tố NEXT_PUBLIC_* ở
# đây (biến đó chỉ có ý nghĩa cho Next.js, service này không cần lộ gì ra
# browser). Load qua `dotenv/config` từ apps/svc-api/.env — app này KHÔNG
# đọc .env.local (khác với các app Next.js).
# Endpoint: /graphql, /api-docs, /events
# =============================================================================

PORT=3005

# Database (Postgres/Neon). Xin đồng nghiệp URL nhánh dev dùng chung, hoặc
# trỏ vào Postgres của riêng bạn. Phải khớp packages/db/.env — cả 2 file
# cùng phải trỏ về đúng 1 database, không thì dữ liệu lệch nhau giữa 2 nơi
# đọc/ghi.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"
# Kết nối trực tiếp (không qua pool), dùng khi chạy `prisma db push` / migrate.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Ở prod còn cần thêm PRISMA_SCHEMA=schema.postgres.prisma (đặt trong Vercel;
# script postinstall của packages/db đọc biến này để chọn đúng schema Prisma).

# Clerk
# Lấy tại: https://dashboard.clerk.com -> app của bạn -> API Keys.
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Lấy tại: app Clerk -> Webhooks -> add endpoint -> Signing Secret.
# Endpoint local: http://localhost:3005/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_replace_me

# CORS
# Danh sách origin frontend, cách nhau bằng dấu phẩy.
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# Sentry (không bắt buộc)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
