# =============================================================================
# apps/svc-api - NestJS backend: GraphQL + REST + SSE (port 3005)
# =============================================================================
# Usage:
#   cp apps/svc-api/.env.example apps/svc-api/.env
#
# This is server-side only. Do not use NEXT_PUBLIC_* here. Loaded via
# `dotenv/config` from apps/svc-api/.env — this app does NOT read .env.local.
# Endpoints: /graphql, /api-docs, /events
# =============================================================================

PORT=3005

# Database (Postgres/Neon). Ask a teammate for the shared dev-branch
# credentials, or point this at your own local Postgres instance. Keep this
# aligned with packages/db/.env — both must point at the same database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"
# Direct (non-pooled) connection, used by `prisma db push` / migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Prod also needs PRISMA_SCHEMA=schema.postgres.prisma (set in Vercel; the
# packages/db postinstall reads it to pick the right Prisma schema).

# Clerk
# Get from: https://dashboard.clerk.com -> your app -> API Keys.
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Get from: Clerk app -> Webhooks -> add endpoint -> Signing Secret.
# Local endpoint: http://localhost:3005/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_replace_me

# CORS
# Comma-separated frontend origins.
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# Sentry (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
